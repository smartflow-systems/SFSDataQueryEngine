generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  company   String?
  password  String
  orgId     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  databases DatabaseConnection[]
  queries   Query[]
  dashboards Dashboard[]
}

model DatabaseConnection {
  id              String   @id @default(cuid())
  userId          String
  orgId           String   @default("")
  name            String
  type            String   // "sqlite", "postgresql", "mysql"
  host            String?
  port            Int?
  database        String
  username        String?
  password        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  queries Query[]

  @@index([userId])
}

model Query {
  id              String   @id @default(cuid())
  userId          String
  databaseId      String?
  naturalLanguage String?
  sqlQuery        String
  executionTime   Int?     // in milliseconds
  rowCount        Int?
  isSaved         Boolean  @default(false)
  name            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  database DatabaseConnection? @relation(fields: [databaseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([databaseId])
  @@index([createdAt])
}

model Dashboard {
  id          String   @id @default(cuid())
  userId      String
  orgId       String   @default("")
  name        String
  description String?
  isShareable Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  charts Chart[]

  @@index([userId])
}

model Chart {
  id          String   @id @default(cuid())
  dashboardId String
  title       String
  type        String   // "bar", "line", "pie", "area"
  data        String   // JSON string
  position    String?  // JSON string for position
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

// =============================================================================
// SocialScaleBooster Integration Models
// These models mirror the SocialScaleBooster database schema for analytics
// They are used when connecting to external SocialScaleBooster databases
// =============================================================================

model SocialUser {
  id                   String    @id @default(cuid())
  username             String    @unique
  password             String
  email                String?
  isPremium            Boolean   @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  botCount             Int       @default(0)
  createdAt            DateTime  @default(now())

  bots      SocialBot[]
  analytics SocialAnalytics[]

  @@map("social_users")
}

model SocialBot {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  platform    String   // 'tiktok', 'instagram', 'facebook', 'twitter', 'youtube', 'multi'
  status      String   @default("active") // 'active', 'paused', 'stopped'
  config      String?  // JSON string for bot configuration
  metrics     String?  // JSON string for performance metrics
  createdAt   DateTime @default(now())

  user      SocialUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics SocialAnalytics[]

  @@index([userId])
  @@index([platform])
  @@index([status])
  @@map("social_bots")
}

model SocialAnalytics {
  id          String   @id @default(cuid())
  userId      String
  botId       String?
  date        DateTime @default(now())
  revenue     Float    @default(0)
  engagement  Float    @default(0)
  posts       Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  impressions Int?     @default(0)
  reach       Int?     @default(0)

  user SocialUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  SocialBot? @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([botId])
  @@index([date])
  @@index([date, userId])
  @@map("social_analytics")
}

model SocialBotTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   // 'E-commerce', 'Beauty', 'Fashion', 'Technology', etc.
  platform    String
  isPremium   Boolean  @default(false)
  price       Float?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  config      String?  // JSON string
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([platform])
  @@index([isPremium])
  @@map("social_bot_templates")
}
