modules = ["nodejs-20"]

[agent]
expertMode = true

# Replit Deployments expects a prod-style run command (no "dev")
run = "node server.js"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33707
externalPort = 3000

[workflows]
runButton = "Run Node Server"

[[workflows.workflow]]
name = "Run Node Server"
author = 36680818
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[nix]
packages = ["gh"]
