# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL="file:./dev.db"

# OpenAI API Configuration
# Required for natural language to SQL translation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Session & Security
SESSION_SECRET=your_random_session_secret_here

# Admin API Authentication
# Required for accessing protected admin endpoints like GET /api/leads
# Generate a secure random string for production
ADMIN_API_KEY=your_secure_admin_api_key_here

# CORS Configuration (optional)
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting (optional)
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=100
# QUERY_RATE_LIMIT_WINDOW_MS=60000
# QUERY_RATE_LIMIT_MAX=20

# =============================================================================
# SocialScaleBooster Integration Configuration
# These settings enable DataLens to connect to SocialScaleBooster's database
# for natural language querying of social media analytics
# =============================================================================

# Social Database Connection (optional)
# If you want to query SocialScaleBooster analytics data, configure these settings
SOCIAL_DB_HOST=localhost
SOCIAL_DB_PORT=5432
SOCIAL_DB_NAME=socialscalebooster
SOCIAL_DB_USER=postgres
SOCIAL_DB_PASSWORD=your_postgres_password_here
SOCIAL_DB_SSL=false

# Social Integration Features (optional)
# Enable/disable specific integration features
SOCIAL_INTEGRATION_ENABLED=true
SOCIAL_REAL_TIME_ANALYTICS=true
SOCIAL_EXPORT_ENABLED=true
SOCIAL_DASHBOARD_TEMPLATES=true
