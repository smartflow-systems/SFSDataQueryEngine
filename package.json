{
  "name": "sfs-data-query-engine",
  "version": "0.1.0",
  "description": "SmartFlow Systems Data Query Engine - AI-powered natural language to SQL translator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "prisma:gen": "prisma generate",
    "prisma:migrate": "prisma migrate dev -n init",
    "health": "bash scripts/health.sh",
    "prestart": "npm run build",
    "sync": "bash scripts/auto-sync.sh",
    "pull": "git pull origin main --no-edit",
    "push": "git push origin main",
    "auto-commit": "git add . && git commit -m 'chore: auto-commit [Auto-Sync]' || true",
    "sync-all": "npm run auto-commit && npm run sync"
  },
